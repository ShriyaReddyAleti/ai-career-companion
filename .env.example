# ─── Copy this file to .env and fill in your values ───────────────────────────

# Database (Docker will create these automatically)
POSTGRES_USER=career_admin
POSTGRES_PASSWORD=choose_a_strong_password
POSTGRES_DB=career_companion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Docker will create this automatically)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=choose_a_redis_password

# API Gateway
API_GATEWAY_PORT=3001
JWT_SECRET=choose_a_long_random_string_at_least_32_chars

# Python Microservice Ports (leave as-is unless you have conflicts)
RESUME_PARSER_PORT=8001
ATS_SCORER_PORT=8002
JOB_MATCHER_PORT=8003
SKILL_GAP_PORT=8004
CHATBOT_PORT=8005
COURSE_RECOMMENDER_PORT=8006

# ─── External API Keys ────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Get from: https://platform.openai.com/api-keys  (optional, fallback)
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# Get from: https://rapidapi.com (used for live job listings, optional)
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE

# Frontend (keep as-is for local dev)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
